# Your Anthropic API key â€” get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ColPali model to use for Vision-First embeddings
# Options:
#   vidore/colqwen2-v1.0      â€” PaliGemma 3B base, ~12GB CPU RAM / ~7GB VRAM
#   vidore/colqwen2-v1.0     â€” Qwen2-VL 2B base,  ~8GB CPU RAM  / ~5GB VRAM (use if RAM-limited)
COLPALI_MODEL=vidore/colqwen2-v1.0

# Local path for LanceDB storage (auto-created on first run)
LANCEDB_PATH=./lancedb_store

# Folder where your PDF documents live
DOCUMENTS_DIR=./documents

# How many top pages to retrieve per query (1â€“5 recommended)
TOP_K_PAGES=3

# Max tokens for Claude generation responses
MAX_TOKENS=2048

